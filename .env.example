# CaseTrace 本机凭据模板：复制为 .env 后填入真实值。
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会提交；本模板不含真实值，可提交。
# 凭据只从本机环境变量或 .env 读取，不写入源码、日志或运行产物。
# 环境变量优先：若已 export DEEPSEEK_API_KEY，会覆盖这里填写的值。
# Leave empty for startup/check-only; fill in your key for real answers.
DEEPSEEK_API_KEY=

# M5 local PostgreSQL. Replace placeholders with two different random passwords.
# Keep the password in each URL identical to CASETRACE_POSTGRES_PASSWORD.
# Use URL-safe passwords; if changing the port, update both URLs as well.
# These bootstrap passwords apply only to a new, empty Docker data volume.
CASETRACE_POSTGRES_ADMIN_PASSWORD=replace_with_random_admin_password
CASETRACE_POSTGRES_PASSWORD=replace_with_random_app_password
CASETRACE_POSTGRES_PORT=5432
CASETRACE_DATABASE_URL=postgresql://casetrace:replace_with_random_app_password@127.0.0.1:5432/casetrace
CASETRACE_TEST_DATABASE_URL=postgresql://casetrace:replace_with_random_app_password@127.0.0.1:5432/casetrace_test

# M6-01 容器路线（compose.yaml 的 api 服务）。两种地址只是主机名与端口写法不同：
#   - 宿主命令（uv run …）走上面的 127.0.0.1 地址，连映射到宿主端口的数据库；
#   - api 容器走下面的服务名地址，通过 Compose 网络直连 postgres 容器的 5432。
# 两条 URL 里的密码都必须与 CASETRACE_POSTGRES_PASSWORD 一致，否则容器连不上库。
# Compose 自动读取本文件做变量替换；缺这两项时 `docker compose` 会明确报错提示补齐。
CASETRACE_CONTAINER_DATABASE_URL=postgresql://casetrace:replace_with_random_app_password@postgres:5432/casetrace
# API 映射到宿主 127.0.0.1 的端口；默认 8000，端口冲突时只改这里。
CASETRACE_API_PORT=8000
